.tabs {
  display: flex;
  background: var(--card);
  position: sticky;
  top: 0;
  z-index: 1;
  border-bottom: 1rpx solid var(--line);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  color: var(--muted);
}

.tab.active {
  color: var(--accent);
  font-weight: 600;
  box-shadow: inset 0 -4rpx 0 var(--accent);
}

.edition-name {
  font-size: 34rpx;
  font-weight: 600;
}

.books {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx -8rpx 0;
}

.book {
  width: calc(33.33% - 16rpx);
  margin: 8rpx;
  padding: 18rpx 8rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: var(--bg);
  text-align: center;
}

.book.current {
  background: var(--accent-soft);
  color: var(--accent);
}

.book-title {
  font-size: 26rpx;
}

.book-count {
  font-size: 22rpx;
  color: var(--muted);
}

.error {
  margin: 16rpx 0 40rpx;
  word-break: break-all;
}
