page {
  --bg: #f5f6f8;
  --card: #ffffff;
  --text: #1f2329;
  --muted: #8a9099;
  --line: #eceef1;
  --accent: #2f6fed;
  --accent-soft: #e8f0fe;
  --warn: #c2410c;

  background: var(--bg);
  color: var(--text);
  font-size: 30rpx;
  line-height: 1.5;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.container {
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.muted {
  color: var(--muted);
  font-size: 26rpx;
}

.section-title {
  font-size: 26rpx;
  color: var(--muted);
  margin: 32rpx 8rpx 16rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--accent-soft);
  color: var(--accent);
  margin-right: 8rpx;
}

.ipa {
  font-family: 'Lucida Sans Unicode', 'Arial Unicode MS', sans-serif;
  color: var(--muted);
}

.btn {
  background: var(--accent);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.btn-plain {
  background: var(--card);
  color: var(--accent);
  border-radius: 999rpx;
  font-size: 28rpx;
}

.state {
  text-align: center;
  padding: 120rpx 48rpx;
  color: var(--muted);
}
